{
  "name": "iitkbucks",
  "version": "2.0.0",
  "description": "A from-scratch cryptocurrency: proof-of-work mining, RSA digital signatures, and a UTXO transaction model",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "dev": "node dev.js",
    "test": "node --test \"test/*.test.js\"",
        "seed": "node scripts/seed.js",
        "build:web": "npm --prefix web run build",
    "install:web": "npm --prefix web install"
  },
  "keywords": [
    "blockchain",
    "cryptocurrency",
    "proof-of-work",
    "utxo",
    "rsa-pss",
    "education"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "body-parser": "^1.20.1",
    "express": "^4.18.2",
    "lodash": "^4.17.21",
    "nano-time": "^1.0.0",
    "raw-body": "^2.5.1",
    "request": "^2.88.2"
  }
}
